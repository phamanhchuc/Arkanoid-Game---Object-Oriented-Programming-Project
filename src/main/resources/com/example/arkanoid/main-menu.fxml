<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.media.MediaView?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="955.5" prefWidth="1200.0"
            fx:controller="com.example.arkanoid.controllers.MenuController">

    <center>
        <AnchorPane fx:id="mainPane" prefHeight="955.5" prefWidth="1200.0">

            <stylesheets>
                <URL value="@menu-styles.css"/>
            </stylesheets>

            <children>

                <!-- BACKGROUND -->
                <ImageView fx:id="mainBackground" fitHeight="955.5" fitWidth="1200.0"
                           pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/backgroundStart.png"/>
                    </image>
                </ImageView>

                <!-- START BUTTON IMAGE -->
                <ImageView fx:id="startImage" fitHeight="150.0" fitWidth="499.0"
                           layoutX="379.0" layoutY="665.0" pickOnBounds="true"
                           preserveRatio="true">
                    <image>
                        <Image url="@images/startButton.png"/>
                    </image>
                </ImageView>

                <!-- INTRO VIDEO -->
                <MediaView fx:id="storyVideoView"
                           fitWidth="1200.0" fitHeight="955.5"
                           preserveRatio="false"
                           visible="false"
                           layoutX="0" layoutY="0"/>

                <!-- STORY IMAGES (OPTIONAL) -->
                <ImageView fx:id="storyImageView" fitHeight="955.5" fitWidth="1200.0"
                           pickOnBounds="true" preserveRatio="false" visible="false"/>

                <!-- STORY TEXTS -->
                <Text fx:id="storyText1" layoutX="50.0" layoutY="80.0" fill="WHITE"
                      visible="false" stroke="#a14da1" strokeWidth="1.5"
                      style="-fx-font-family: 'Arial'; -fx-font-weight: bold;"
                      wrappingWidth="550.0">
                    <font>
                        <Font size="28.0"/>
                    </font>
                </Text>

                <Text fx:id="storyText2" layoutX="50.0" layoutY="800.0" fill="WHITE"
                      visible="false" stroke="#a14da1" strokeWidth="1.5"
                      style="-fx-font-family: 'Arial'; -fx-font-weight: bold;"
                      wrappingWidth="550.0">
                    <font>
                        <Font size="28.0"/>
                    </font>
                </Text>

                <Text fx:id="storyText3" layoutX="620.0" layoutY="80.0" fill="WHITE"
                      visible="false" stroke="#a14da1" strokeWidth="1.5"
                      style="-fx-font-family: 'Arial'; -fx-font-weight: bold;"
                      wrappingWidth="550.0">
                    <font>
                        <Font size="28.0"/>
                    </font>
                </Text>

                <!-- START BUTTON -->
                <Button fx:id="buttonStart" layoutX="420.0" layoutY="679.0"
                        prefHeight="105.0" prefWidth="359.0"
                        style="-fx-background-color: transparent;"
                        mnemonicParsing="false"/>

                <!-- SETTING ICON + BUTTON -->
                <ImageView fx:id="settingImage" fitHeight="150.0" fitWidth="33.0"
                           layoutX="1050.0" layoutY="118.0"
                           pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/settingButton.png"/>
                    </image>
                </ImageView>

                <Button fx:id="buttonSetting" layoutX="1031.0" layoutY="114.0"
                        prefHeight="39.0" prefWidth="71.0"
                        style="-fx-background-color: transparent;"
                        mnemonicParsing="false"/>

                <!-- RANKING ICON + BUTTON -->
                <ImageView fx:id="rankingImage" fitHeight="49.0" fitWidth="62.0"
                           layoutX="1042.0" layoutY="180.0"
                           pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/rankingButton.png"/>
                    </image>
                </ImageView>

                <Button fx:id="buttonRanking" layoutX="1031.0" layoutY="184.0"
                        prefHeight="39.0" prefWidth="72.0"
                        style="-fx-background-color: transparent;"
                        mnemonicParsing="false"/>

                <!-- GUIDE ICON + BUTTON -->
                <ImageView fx:id="guideImageBtn" fitHeight="42.0" fitWidth="35.0"
                           layoutX="1050.0" layoutY="255.0"
                           pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/guideButton.png"/>
                    </image>
                </ImageView>

                <Button fx:id="buttonGuide" layoutX="1032.0" layoutY="255.0"
                        prefHeight="42.0" prefWidth="70.0"
                        style="-fx-background-color: transparent;"
                        mnemonicParsing="false"/>

                <!-- GUIDE PAGE -->
                <ImageView fx:id="guideImageView" fitHeight="955.5" fitWidth="1200.0"
                           preserveRatio="true" visible="false"/>

                <Button fx:id="backButtonGuide" layoutX="500.0" layoutY="860.0"
                        prefHeight="85.0" prefWidth="226.0"
                        styleClass="back-button" visible="false"/>

                <!-- RANKING PAGE -->
                <ImageView fx:id="rankingImageView" fitHeight="955.5" fitWidth="1200.0"
                           preserveRatio="true" visible="false"/>

                <Text fx:id="rank1Text" layoutX="500.0" layoutY="520.0"
                      text="1. N/A" visible="false">
                    <font>
                        <Font size="22.0" name="System Bold"/>
                    </font>
                </Text>

                <Text fx:id="rank2Text" layoutX="720.0" layoutY="570.0"
                      text="2. N/A" visible="false">
                    <font>
                        <Font size="22.0" name="System Bold"/>
                    </font>
                </Text>

                <Text fx:id="rank3Text" layoutX="320.0" layoutY="630.0"
                      text="3. N/A" visible="false">
                    <font>
                        <Font size="22.0" name="System Bold"/>
                    </font>
                </Text>

                <Button fx:id="backButtonRanking" layoutX="500.0" layoutY="860.0"
                        prefHeight="85.0" prefWidth="226.0"
                        styleClass="back-button" visible="false"/>

                <!-- SETTINGS -->
                <ImageView fx:id="settingsBackground" fitHeight="500.0" fitWidth="750.0"
                           layoutX="250.0" layoutY="200.0"
                           preserveRatio="true" visible="false">
                    <image><Image url="@images/setting.png"/></image>
                </ImageView>

                <VBox fx:id="settingsPane" alignment="CENTER"
                      layoutX="300.0" layoutY="250.0"
                      prefHeight="400.0" prefWidth="600.0"
                      spacing="20.0" visible="false">

                    <children>
                        <Text fill="WHITE" text="Âm Lượng">
                            <font><Font size="24.0" name="System Bold"/></font>
                        </Text>

                        <Slider fx:id="volumeSlider" min="0" max="1" value="1"
                                showTickLabels="true" showTickMarks="true"
                                blockIncrement="0.1" majorTickUnit="0.2"
                                maxWidth="300.0" styleClass="volume-slider"/>

                        <Button fx:id="backButtonSettings"
                                prefHeight="85.0" prefWidth="226.0"
                                styleClass="back-button"/>
                    </children>

                </VBox>

            </children>
        </AnchorPane>
    </center>
</BorderPane>
